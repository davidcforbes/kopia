<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Author>david</Author>
    <Description>Backup Server waker: fires backup-server.exe --run-once --job weekly_replica_verify at 06:30 Saturdays. Replaces \Backup\WeeklyReplicaVerify as the orchestrator (the underlying weekly_replica_verify.ps1 still runs as a legacy worker). See plan keen-dancing-sparkle.md §"Phase 1.3: cut-over plan" and beads kopia-0dr.4.</Description>
    <URI>\Backup\BackupServerWaker-WeeklyReplicaVerify</URI>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <UserId>S-1-5-21-689530412-1940644328-2138015469-1001</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT2H</ExecutionTimeLimit>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <StartWhenAvailable>true</StartWhenAvailable>
    <IdleSettings>
      <Duration>PT10M</Duration>
      <WaitTimeout>PT1H</WaitTimeout>
      <StopOnIdleEnd>true</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
    <Priority>5</Priority>
  </Settings>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-05-23T06:30:00</StartBoundary>
      <ScheduleByWeek>
        <WeeksInterval>1</WeeksInterval>
        <DaysOfWeek>
          <Saturday />
        </DaysOfWeek>
      </ScheduleByWeek>
    </CalendarTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>C:\dev\backup-monitor\target\release\backup-server.exe</Command>
      <Arguments>--run-once --job weekly_replica_verify --config C:\BackupServer\jobs.toml</Arguments>
    </Exec>
  </Actions>
</Task>
