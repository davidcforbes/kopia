<?xml version="1.0" encoding="UTF-16"?>

<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">

  <RegistrationInfo>

    <Author>david</Author>

    <Description>Long-running upstream kopia repository server. Spawns kopia.exe server bound to 127.0.0.1:51515 with a stable TLS cert, holding D:\KopiaRepo so all clients (KopiaUI, daily_kopia_backup.cmd) talk via REST. Created DISABLED — enable as part of the cutover (epic kopia-7s7).</Description>

    <URI>\Backup\KopiaServer</URI>

  </RegistrationInfo>

  <Principals>

    <Principal id="Author">

      <UserId>S-1-5-21-689530412-1940644328-2138015469-1001</UserId>

      <LogonType>S4U</LogonType>

      <RunLevel>HighestAvailable</RunLevel>

    </Principal>

  </Principals>

  <Settings>

    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>

    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>

    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>

    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>

    <RestartOnFailure>

      <Count>3</Count>

      <Interval>PT1M</Interval>

    </RestartOnFailure>

    <StartWhenAvailable>true</StartWhenAvailable>

    <IdleSettings>

      <StopOnIdleEnd>true</StopOnIdleEnd>

      <RestartOnIdle>false</RestartOnIdle>

    </IdleSettings>

    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>

    <Priority>5</Priority>

  </Settings>

  <Triggers>

    <BootTrigger />

  </Triggers>

  <Actions Context="Author">

    <Exec>

      <Command>C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe</Command>

      <Arguments>-NoProfile -ExecutionPolicy Bypass -File C:\dev\kopia\scripts\start_kopia_server.ps1</Arguments>

    </Exec>

  </Actions>

</Task>
