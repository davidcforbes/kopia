<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Author>david</Author>
    <Description>RustBack waker: fires rustback-server.exe --run-once --job kopia_snapshot at 03:00 daily. Replaces \Backup\DailyKopiaSnapshotV2 as the orchestrator (the underlying daily_kopia_backup.cmd still runs as a legacy worker). See plan keen-dancing-sparkle.md §"Phase 1.3: cut-over plan" and beads kopia-0dr.4.</Description>
    <URI>\Backup\RustBackWaker-Kopia</URI>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <UserId>S-1-5-21-689530412-1940644328-2138015469-1001</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT8H</ExecutionTimeLimit>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <StartWhenAvailable>true</StartWhenAvailable>
    <IdleSettings>
      <Duration>PT10M</Duration>
      <WaitTimeout>PT1H</WaitTimeout>
      <StopOnIdleEnd>true</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
    <Priority>5</Priority>
  </Settings>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-05-17T03:00:00</StartBoundary>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>C:\dev\rustback\target\release\rustback-server.exe</Command>
      <Arguments>--run-once --job kopia_snapshot --config C:\RustBack\jobs.toml</Arguments>
    </Exec>
  </Actions>
</Task>
